#pragma once
#ifndef TONB_CONFIG_HXX
#define TONB_CONFIG_HXX

// This file is generated by CMake from config.hpp.in — do not edit directly.

// -----------------------
// Version (optional)
// -----------------------
#define TONB_VERSION_MAJOR @TONB_VERSION_MAJOR@
#define TONB_VERSION_MINOR @TONB_VERSION_MINOR@
#define TONB_VERSION_PATCH @TONB_VERSION_PATCH@

// -----------------------
// Feature toggles (0/1)
// -----------------------
// CMake will expand these to `#define ... 1` or `#define ... 0`
#cmakedefine01 TONB_WITH_OCCT
#cmakedefine01 TONB_WITH_CGAL
#cmakedefine01 TONB_WITH_EIGEN
#cmakedefine01 TONB_WITH_VTK

// Convenience aliases (if you prefer HAS_* names)
#if TONB_WITH_OCCT
  #define TONB_HAS_OCCT 1
#else
  #define TONB_HAS_OCCT 0
#endif

#if TONB_WITH_CGAL
  #define TONB_HAS_CGAL 1
#else
  #define TONB_HAS_CGAL 0
#endif

#if TONB_WITH_EIGEN
  #define TONB_HAS_EIGEN 1
#else
  #define TONB_HAS_EIGEN 0
#endif

#if TONB_WITH_VTK
   #define TONB_HAS_VTK 1
#else
   #define TONB_HAS_VTK 0
#endif

/* If Cmake figured out the VTK major, it will #define this to a number
   Otherwise it will leave it undefined and we'll derive it from vtkversion.h */
#cmakedefine TONB_VTK_MAJOR @TONB_VTK_MAJOR@

#if TONB_WIT_VTK && !defined(TONB_VTK_MAJOR)
    #include <vtkVersion.h> // provides VTK_MAJOR_VERSION
    #define TONB_VTK_MAJOR VTK_MAJOR_VERSION
#endif

// Optional: a compact compile-time string for logging/banners
#define TONB_FEATURES_OCCT   (TONB_HAS_OCCT ? "on" : "off")
#define TONB_FEATURES_CGAL   (TONB_HAS_CGAL ? "on" : "off")
#define TONB_FEATURES_EIGEN  (TONB_HAS_EIGEN ? "on" : "off")
#define TONB_FEATURES_VTK    (TONB_HAS_VTK ? "on" : "off")

/* Keep old name if you prefer it in headers */
#define TONB_HAS_OCCT_ADAPTERS TONB_HAS_OCCT

#endif //TONB_CONFIG_HXX